# 环境类型 dev / prod
ENVIRONMENT=dev

# 数据库
DATABASE_URL=sqlite:///./chat_app.db
# 上线改成postgres，例如：
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/chatdb"

# 默认模型
DEFAULT_LLM_MODEL=kimi-k2.6
DEFAULT_LLM_API_KEY=sk-你的key

# JWT 认证 | openssl rand -hex 32
SECRET_KEY=your-super-secret-key-please-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
